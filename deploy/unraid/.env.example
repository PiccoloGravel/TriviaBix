# Your Unraid server's LAN address plus the port below. Keep it the LAN one even when you play
# away from home: a TV opened on the https address shows that address in its QR code by itself.
PUBLIC_URL=http://192.168.1.20:8080
# Pick something long (12+ characters, more if the game is reachable from the internet); anyone
# with it can change rooms and questions.
ADMIN_PASSWORD=
TRIVIABIX_PORT=8080
MAX_PLAYERS=12
PUID=99
PGID=100
TZ=America/New_York
# Optional: play songs from your own library through Lidarr.
# Lidarr → Settings → General → Security → API Key.
LIDARR_URL=http://192.168.1.20:8686
LIDARR_API_KEY=
# The music share on Unraid (mounted read-only at /music), and the same folder as Lidarr sees it.
MUSIC_SHARE=/mnt/user/data/media/music
LIDARR_MUSIC_PATH=
LIBRARY_RATING=PG-13
# Bix's voice (needs an NVIDIA GPU; start the stack with the "voice" profile). Empty uses the browser voice.
TTS_URL=
BIX_VOICE=ip:US_James
# Optional: the admin panel's Rendering page. vast.ai rents GPUs for Bix's voice and cutscene art
# (keep a small prepaid credit with auto-reload off); Anthropic is for Claude-written host lines.
VAST_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
# Playing away from home (see REMOTE.md). Tailscale Funnel ("funnel" profile): an auth key from
# https://login.tailscale.com/admin/settings/keys, used once.
TS_AUTHKEY=
TS_HOSTNAME=triviabix
# Or Cloudflare Tunnel ("tunnel" profile): the token Cloudflare shows when you make the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
