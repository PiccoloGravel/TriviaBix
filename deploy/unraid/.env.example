# Your Unraid server's LAN address plus the port below.
PUBLIC_URL=http://192.168.1.20:8080
# Pick something long; anyone with it can change rooms and questions.
ADMIN_PASSWORD=
TRIVIABIX_PORT=8080
MAX_PLAYERS=12
PUID=99
PGID=100
TZ=America/New_York
# Bix's voice (needs an NVIDIA GPU; start the stack with the "voice" profile). Empty uses the browser voice.
TTS_URL=
BIX_VOICE=ip:US_James
