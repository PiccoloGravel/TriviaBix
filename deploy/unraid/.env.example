# Your Unraid server's LAN address plus the port below.
PUBLIC_URL=http://192.168.1.20:8080
# Pick something long; anyone with it can change rooms and questions.
ADMIN_PASSWORD=
TRIVIABIX_PORT=8080
MAX_PLAYERS=12
PUID=99
PGID=100
TZ=America/New_York
# Optional: play songs from your own library through Lidarr.
# Lidarr → Settings → General → Security → API Key.
LIDARR_URL=http://192.168.1.20:8686
LIDARR_API_KEY=
# The music share on Unraid (mounted read-only at /music), and the same folder as Lidarr sees it.
MUSIC_SHARE=/mnt/user/data/media/music
LIDARR_MUSIC_PATH=
LIBRARY_RATING=PG-13
