#!/usr/bin/env python3
"""A stand-in for the triviabix-questions line writer in the render tests."""
import json, sys
from pathlib import Path

import os

args = sys.argv[1:]
# Which persona it was given, on one line, so the tests can tell the Settings page's reached it.
persona = os.environ.get("HOST_PERSONA", "").replace("\n", "|")
(Path(__file__).resolve().parent / "calls.log").open("a").write(
    " ".join(["lines", *args]) + (f" [persona {persona}]" if persona else "")
    + (f" [scripts {os.environ['SCRIPTS_PERSONA']}]" if os.environ.get("SCRIPTS_PERSONA") else "") + "\n")
if "import" in args:
    # Writes a pack like the real importer and reports which questions it added.
    content = Path(args[args.index("--content") + 1])
    out = content / "packs/imported/opentdb-test.toml"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text('[pack]\nname = "Imported"\ncategory = "general"\n\n'
                   '[[question]]\nid = "opentdb-fake1"\ntype = "true_false"\n'
                   'prompt = "The fake importer wrote this."\nanswer = true\n')
    print("@tbx " + json.dumps({"event": "imported", "fetched": 2, "added": 1, "skipped": 1,
                                "flagged": 0, "invalid": 0, "pack": "packs/imported/opentdb-test.toml",
                                "ids": ["opentdb-fake1"]}), file=sys.stderr)
    print("Added 1 question (1 already in the bank).")
    sys.exit(0)
print("@tbx " + json.dumps({"event": "todo", "count": 1, "total": 7}), file=sys.stderr)
if "--dry-run" not in args:
    print("@tbx " + json.dumps({"event": "progress", "batch": 1, "batches": 1, "written": 1,
                                "input_tokens": 900, "output_tokens": 120}), file=sys.stderr)
    print("Wrote lines for 1 questions (0 skipped).")
